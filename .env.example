# Copy to `.env` and adjust. See krater/config.py for the full list of settings.

KRATER_ENV=development
# In docker-compose, the db host is the `db` service; for `bin/dev` locally, use localhost.
KRATER_DATABASE_URL=postgresql+psycopg://krater:krater@db:5432/krater
KRATER_SECRET_KEY=change-me-in-production
KRATER_BASE_URL=http://localhost:8000

# Weave (Patchwork Labs identity provider) integration. See docs/weave-integration.md.
# `stub` replaces Weave with a local fixture of fake users; required outside of production.
KRATER_WEAVE_MODE=stub
KRATER_WEAVE_ISSUER=
KRATER_WEAVE_CLIENT_ID=
KRATER_WEAVE_CLIENT_SECRET=
KRATER_WEAVE_API_BASE_URL=
KRATER_WEAVE_SERVICE_KEY=
KRATER_WEAVE_STUB_USERS_FILE=

# docker-compose only: the `db` service's own credentials.
POSTGRES_USER=krater
POSTGRES_PASSWORD=krater
POSTGRES_DB=krater
PORT=8000
