# Copy to `.env` and adjust. See krater/config.py for the full list of settings.

KRATER_ENV=development
# In docker-compose, the db host is the `db` service; for `bin/dev` locally, use localhost.
KRATER_DATABASE_URL=postgresql+psycopg://krater:krater@db:5432/krater
KRATER_SECRET_KEY=change-me-in-production
KRATER_BASE_URL=http://localhost:8000

# Weave (Patchwork Labs identity provider) integration. See docs/weave-integration.md.
# `stub` replaces Weave with a local fixture of fake users; required outside of production.
KRATER_WEAVE_MODE=stub
KRATER_WEAVE_ISSUER=
KRATER_WEAVE_CLIENT_ID=
KRATER_WEAVE_CLIENT_SECRET=
KRATER_WEAVE_API_BASE_URL=
KRATER_WEAVE_SERVICE_KEY=
KRATER_WEAVE_STUB_USERS_FILE=

# SkyPilot integration. See docs/skypilot-integration.md, docs/dev/skypilot-spike.md and
# docs/dev/staging.md. `fake` = in-memory SkyPilot for local dev; switching to `live` also needs the
# `skypilot` compose profile (`docker compose --profile skypilot up`) -- see below.
KRATER_SKYPILOT_MODE=fake
KRATER_SKYPILOT_API_URL=http://skypilot:46580
# A service-account bearer token (`sky_...`), minted once against the running server -- see
# docs/dev/staging.md's bootstrap steps. Never the KRATER_SKYPILOT_BASIC_AUTH_* credentials below.
KRATER_SKYPILOT_SERVICE_TOKEN=
# Shared secret carried in the admin-policy URL's query string. Generate with, e.g., `openssl rand -hex 32`.
# Not a strong secret by itself -- see krater/config.py's comment -- but still don't commit a real one.
KRATER_SKYPILOT_POLICY_TOKEN=

# -- `skypilot` compose profile only (docker compose --profile skypilot up) -------------------------
# This portal's own URL as reachable from wherever members run `sky launch` -- NOT an internal Docker
# hostname. The SkyPilot server's generated admin_policy config uses this (see docs/dev/skypilot-spike.md
# Surprise #1: the policy endpoint is also called client-side, from members' own machines).
KRATER_PUBLIC_URL=http://localhost:8000
# Basic-auth credentials for the SkyPilot API server, used only once to bootstrap the service-account
# token above (ENABLE_BASIC_AUTH + ENABLE_SERVICE_ACCOUNTS both required -- see the spike). Not used by
# member sign-in, which goes through `auth-proxy` instead.
KRATER_SKYPILOT_BASIC_AUTH_USER=admin
KRATER_SKYPILOT_BASIC_AUTH_PASSWORD=
# Local path to a file holding your Vast.ai API key (one line, never committed), mounted read-only into
# the `skypilot` container. See docs/dev/staging.md for how to get a (small-credit!) key.
KRATER_SKYPILOT_VAST_KEY_FILE=
# Which host/port the `skypilot` API server listens on for host access (rarely needed directly; members
# go through `auth-proxy` instead).
SKYPILOT_PORT=46580

# oauth2-proxy (`auth-proxy` service), fronting `skypilot` with Weave sign-in. See
# docs/skypilot-integration.md section 0. Uses KRATER_WEAVE_ISSUER above (same Weave instance as Krater
# itself), but a SEPARATE Weave OAuth app/client -- register it as its own confidential app.
KRATER_SKYPILOT_AUTH_CLIENT_ID=
KRATER_SKYPILOT_AUTH_CLIENT_SECRET=
# 32 random bytes, base64/urlsafe-encoded, e.g.:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
KRATER_SKYPILOT_AUTH_COOKIE_SECRET=
# This proxy's own public URL (what a member's browser/`sky api login` hits), used to build its OIDC
# redirect_url. Set `false` for KRATER_SKYPILOT_AUTH_COOKIE_SECURE only over plain http (local dev).
KRATER_SKYPILOT_PUBLIC_URL=http://localhost:46580
KRATER_SKYPILOT_AUTH_COOKIE_SECURE=true
SKYPILOT_AUTH_PROXY_PORT=8080

# S3-compatible object storage for gallery screenshots (not wired into the app yet).
# docker-compose runs a temporary SeaweedFS container as `storage`. The app talks to it on the internal endpoint;
# browsers get presigned URLs on the public one. Change the secret for anything beyond local dev.
KRATER_S3_ENDPOINT_URL=http://storage:8333
KRATER_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
KRATER_S3_REGION=us-east-1
KRATER_S3_BUCKET=krater-screenshots
KRATER_S3_ACCESS_KEY_ID=krater
KRATER_S3_SECRET_ACCESS_KEY=krater-dev-secret

# docker-compose only: the `db` service's own credentials.
POSTGRES_USER=krater
POSTGRES_PASSWORD=krater
POSTGRES_DB=krater
PORT=8000
